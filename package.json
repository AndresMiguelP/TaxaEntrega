  "keywords": [
    "jest",
    "iso25010",
    "iso29119",
    "software-testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7"
  },
  "jest-html-reporters": {
    "publicPath": "./relatorio-iso29119",
    "filename": "relatorio_testes.html",
    "pageTitle": "ISO 29119-3: Test Summary Report - ISO 25010 Quality Audit",
    "expand": true
  }
}