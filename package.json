{
  "name": "lab-teste-software-iso",
  "version": "1.0.0",
  "description": "Laboratório Prático de Teste de Software - ISO 25010 e ISO 29119",
  "main": "taxaEntrega.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:report": "jest --reporters=default --reporters=jest-html-reporters"
